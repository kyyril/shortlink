APP_ENV=development
HTTP_ADDR=:8080
BASE_URL=http://localhost:8080
DATABASE_URL=postgres://shortlink:shortlink@localhost:5433/shortlink?sslmode=disable
JWT_SECRET=change-me-to-at-least-32-bytes-long-secret
JWT_TTL=15m
LOG_LEVEL=info
LOG_FORMAT=json
SHUTDOWN_TIMEOUT=15s
REQUEST_TIMEOUT=5s
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
CLICK_BUFFER_SIZE=1024
